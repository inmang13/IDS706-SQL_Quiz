# Copy to .env (never commit .env). Session pooler string for the read-only role.
# Username is quiz_reader.<project-ref>; use a password with only letters and numbers.
QUIZ_READER_DATABASE_URL=postgresql://quiz_reader.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres?sslmode=require
